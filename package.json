{
  "name": "inskavex-website",
  "version": "1.0.0",
  "private": true,
  "description": "Official website of Inskavex — static site for Cloudflare Pages.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs",
    "check": "node scripts/build.mjs && node scripts/check.mjs",
    "check:launch": "node scripts/check.mjs --launch",
    "test": "npm run check && playwright test",
    "test:e2e": "playwright test",
    "assets:images": "node scripts/brand/render-images.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "axe-core": "4.13.0",
    "html-validate": "11.16.2"
  }
}
